# Public Cognito identifiers used by Amplify Auth in the browser.
# The app client must not have a client secret.
# Auth derives its AWS region from the User Pool ID; this region value is
# available for any additional AWS services you connect later.
VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared API Gateway base URL. Profile/team and /market/* routes use this by default.
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-southeast-2.amazonaws.com
# Optional service-specific overrides:
# VITE_PROFILE_API_URL=https://profile-api-id.execute-api.ap-southeast-2.amazonaws.com
# VITE_MARKET_API_URL=https://market-api-id.execute-api.ap-southeast-2.amazonaws.com

# Use "appsync" for the Fargate -> AppSync Events feed, or "mock" locally.
VITE_MARKET_DATA_PROVIDER=appsync
VITE_MARKET_TICK_MS=1500

# Amplify derives the realtime WebSocket endpoint from this HTTP endpoint.
# Fargate publishes batched NSE updates to one channel.
VITE_APPSYNC_EVENT_ENDPOINT=https://your-api-id.appsync-api.ap-southeast-2.amazonaws.com/event
VITE_APPSYNC_EVENT_REGION=ap-southeast-2
VITE_APPSYNC_EVENT_AUTH_MODE=userPool
VITE_APPSYNC_EVENT_CHANNEL=/market/nse
VITE_MARKET_SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,SBIN

# API Gateway base URL for Lambda-backed Upstox REST routes.
# The frontend calls GET /quotes?symbols=RELIANCE,TCS outside market hours.
VITE_MARKET_QUOTES_PATH=/market/quotes

# Required only when VITE_APPSYNC_EVENT_AUTH_MODE=apiKey.
VITE_APPSYNC_EVENT_API_KEY=
